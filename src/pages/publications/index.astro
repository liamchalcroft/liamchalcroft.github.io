---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import SectionHead from '../../components/SectionHead.astro';
import ScanTile from '../../components/ScanTile.astro';
import { authorsHtml, site, year } from '../../lib/site';
import { tileParams } from '../../lib/paperTile';

const pubs = (await getCollection('publications')).sort((a, b) => +b.data.date - +a.data.date);
const number = new Map(pubs.map((p, i) => [p.id, i + 1]));
const groups = [
  { kind: 'journal', title: 'Journal papers' },
  { kind: 'conference', title: 'Conference papers' },
  { kind: 'workshop', title: 'Workshop papers' },
  { kind: 'thesis', title: 'Thesis' },
] as const;
const sections = groups
  .map((g) => ({ ...g, items: pubs.filter((p) => p.data.kind === g.kind) }))
  .filter((g) => g.items.length > 0);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Publications"
  series="01"
  description="Journal, conference and workshop papers, and the PhD thesis, by Liam Chalcroft: domain generalisation, synthetic data and self-supervised pre-training for medical imaging."
>
  <PageHead code="01" label="Papers" title="Publications">
    <p>
      Journal, conference and workshop papers, and the thesis, newest first within each kind. The same list is on{' '}
      <a href={site.links.scholar} rel="me">Google Scholar</a> and <a href={site.links.orcid} rel="me">ORCID</a>.
      Each thumbnail is synthesised from the paper's slug, not taken from the paper.
    </p>
    <Fragment slot="aside">
      <dl class="readout">
        <dt>Papers</dt><dd>{pubs.length}</dd>
        <dt>Latest</dt><dd>{year(pubs[0]!.data.date)}</dd>
        <dt>Feed</dt><dd><a href="/publications/feed.xml">RSS</a></dd>
      </dl>
    </Fragment>
  </PageHead>

  {sections.map((s, si) => (
    <>
      <SectionHead code={pad(si + 1)} title={s.title} id={s.kind} aside={`${s.items.length} ${s.items.length === 1 ? 'entry' : 'entries'}`} />
      <section class="list sheet" aria-labelledby={s.kind}>
        {s.items.map((p) => {
          const d = p.data;
          const t = tileParams(p);
          const href = `/publication/${p.id}/`;
          return (
            <>
              <a class="row__thumb" href={href} tabindex="-1" aria-hidden="true">
                <ScanTile
                  kind={t.kind}
                  n={128}
                  z={t.z}
                  seed={t.seed}
                  protocol={t.protocol}
                  duration={1000}
                  hover="replay"
                  label=""
                  tl={[`IM ${pad(number.get(p.id)!)}`, t.modalityLabel]}
                  br={[String(year(d.date))]}
                />
              </a>
              <article class="row__body cell raster">
                <div class="entry__meta">
                  <span class="label">{year(d.date)}</span>
                  <span class="label">{d.venueShort}</span>
                  {d.badge && <span class="badge">{d.badge}</span>}
                </div>
                <h3 class="entry__title"><a href={href}>{d.title}</a></h3>
                <p class="entry__authors" set:html={authorsHtml(d.authors, d.etAl)} />
                <p class="entry__venue">{d.venue}</p>
                {d.note && <p class="row__note faint">{d.note}</p>}
                <ul class="entry__links">
                  {d.links.paper && <li><a href={d.links.paper}>Paper</a></li>}
                  {d.links.arxiv && <li><a href={d.links.arxiv}>arXiv</a></li>}
                  {d.links.code && <li><a href={d.links.code}>Code</a></li>}
                  {d.links.extra.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
                </ul>
              </article>
            </>
          );
        })}
      </section>
    </>
  ))}
</Base>

<script>
  import { initScans } from '../../scripts/scan-client';
  initScans();
</script>

<style>
  .row__thumb { grid-column: span 2; display: block; background: var(--film); text-decoration: none; }
  .row__body { grid-column: span 10; }
  .row__thumb :global(.tile) { aspect-ratio: 1; }
  .row__note { margin-top: 4px; font-size: 0.88rem; }
  .row__body :global(.entry__title) { max-width: 60ch; }

  @media (max-width: 1080px) {
    .row__thumb { grid-column: span 3; }
    .row__body { grid-column: span 9; }
  }
  /* Phones: a fixed-width film thumbnail beside the text, top-aligned, with the film black continuing down its column. */
  @media (max-width: 640px) {
    .list { grid-template-columns: 92px minmax(0, 1fr); }
    .row__thumb, .row__body { grid-column: auto; }
    .row__body { padding: 14px 14px 16px; }
    .row__thumb :global(.ann) { font-size: 8px; padding: 4px 5px; }
    .row__thumb :global(.ann span:not(:first-child)) { display: none; }
    .row__thumb :global(.ann--br) { display: none; }
    .row__body :global(.entry__title) { font-size: 1.02rem; }
  }
</style>
