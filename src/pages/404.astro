---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="There is no page at this address." noindex>
  <section class="lost wide with-note" aria-labelledby="page-title">
    <div>
      <!-- Not data-denoise: this heading is held at a fixed, very noisy timestep by the script below. -->
      <h1 class="display lost__title" id="page-title" data-noisy>Page not found</h1>
      <div class="lost__text">
        <p class="lede">There is no page at this address.</p>
        <p class="lost__links">
          <a href="/">Home page</a>
          <a href="/publications/">Publications</a>
        </p>
      </div>
    </div>
    <p class="note lost__note">Requested address: <i id="path" class="lost__path">this address</i></p>
  </section>
</Base>

<script>
  // Hold the heading near pure noise: glyphs sit between Redaction 50 and a random substitute
  // letter, and the substitutes are re-drawn a few times a second. Same markup as denoise.ts.
  const h1 = document.querySelector<HTMLElement>('[data-noisy]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const pathEl = document.getElementById('path');
  if (pathEl) pathEl.textContent = location.pathname + location.search;

  if (h1) {
    const LOWER = 'abcdefghijklmnopqrstuvwxyz';
    const UPPER = LOWER.toUpperCase();
    const PUNCT = '.,:;-!?/*';
    const setFor = (ch: string) => (UPPER.includes(ch) ? UPPER : LOWER.includes(ch) ? LOWER : PUNCT);
    const pick = (s: string) => s[Math.floor(Math.random() * s.length)]!;

    const subs: { el: HTMLElement; set: string }[] = [];
    const text = h1.textContent ?? '';
    const frag = document.createDocumentFragment();
    for (const part of text.split(/(\s+)/)) {
      if (!part) continue;
      if (/^\s+$/.test(part)) { frag.append(part); continue; }
      const word = document.createElement('span');
      word.className = 'dn__w';
      for (const ch of part) {
        const g = document.createElement('span');
        g.className = 'dn__g';
        g.textContent = ch;
        const r = Math.random();
        const level = r < 0.15 ? 4 : r < 0.4 ? 5 : r < 0.7 ? 6 : 7; // 4 to 7, weighted towards the noisy end
        g.dataset['l'] = String(level);
        g.dataset['c'] = ch;
        if (level === 7) {
          const set = setFor(ch);
          g.dataset['c'] = pick(set);
          subs.push({ el: g, set });
        }
        word.append(g);
      }
      frag.append(word);
    }
    h1.replaceChildren(frag);

    if (!reduced && subs.length) {
      setInterval(() => {
        for (const s of subs) s.el.dataset['c'] = pick(s.set);
      }, 250);
    }
  }
</script>

<style>
  .lost { padding-top: clamp(3rem, 14vh, 10rem); align-items: end; }
  .lost__text { margin-top: clamp(1.6rem, 3vw, 2.6rem); max-width: 30em; }
  .lost__links { margin-top: 1.2rem; display: flex; flex-wrap: wrap; gap: 0.2rem 1.4rem; font-style: italic; }
  .lost__note { padding-bottom: 0.4rem; }
  .lost__path { overflow-wrap: anywhere; }
</style>
