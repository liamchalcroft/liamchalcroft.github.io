---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, year } from '../lib/site';
import { experience, education, teaching, skills } from '../data/cv';
import { talks } from '../data/talks';
import type { CvEntry } from '../data/types';

const pubs = (await getCollection('publications')).sort((a, b) => +b.data.date - +a.data.date);
const month = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const talkKind = { oral: 'oral', invited: 'invited talk', poster: 'poster', seminar: 'seminar' } as const;

// The PhD funding line lives here rather than in the data file.
const withFunding = (rows: CvEntry[]) =>
  rows.map((r) =>
    r.role.startsWith('PhD') ? { ...r, points: [...(r.points ?? []), 'i4health CDT (EPSRC and Wellcome).'] } : r,
  );

const blocks: { title: string; id: string; rows: CvEntry[]; honours?: boolean }[] = [
  { title: 'Experience', id: 'experience', rows: experience },
  { title: 'Education', id: 'education', rows: withFunding(education), honours: true },
  { title: 'Teaching and supervision', id: 'teaching', rows: teaching },
];
---

<Base
  title="Curriculum vitae"
  description="Curriculum vitae of Dr Liam Chalcroft: Founding Computer Vision Scientist at Prospectral, PhD in machine learning for medical imaging from University College London."
>
  <header class="intro wide with-note">
    <div>
      <h1 class="display" data-denoise="load" data-key="cv">Curriculum vitae</h1>
      <p class="lede intro__text">
        Machine learning researcher working on medical and spectral imaging: domain generalisation, physics-constrained synthetic data, and self-supervised pre-training for 3D imaging. Currently Founding Computer Vision Scientist at Prospectral.
      </p>
      <p class="intro__print no-print"><button class="button" type="button" id="print">Print or save as PDF</button></p>
    </div>
    <p class="note intro__note">
      <a href={`mailto:${site.email}`}>{site.email}</a><br />
      <a href={site.links.scholar} rel="me">Google Scholar</a><br />
      <a href={site.links.orcid} rel="me">ORCID</a><br />
      <a href={site.links.github} rel="me">GitHub</a>
    </p>
  </header>

  {blocks.map((b) => (
    <section class="section wide" aria-labelledby={b.id}>
      <h2 class="h2" id={b.id} data-denoise="scroll" data-denoise-hover>{b.title}</h2>
      <ul class="work cv">
        {b.rows.map((r) => (
          <li class="work__item with-note">
            <div>
              <p class="cv__role"><b>{r.role}</b></p>
              <p class="work__meta small">
                {r.orgUrl ? <a href={r.orgUrl}>{r.org}</a> : r.org}
                {r.place && (b.honours ? <>, <i>{r.place}</i></> : <>, {r.place}</>)}
              </p>
              {r.points && r.points.length > 0 && (
                <ul class="cv__points small">
                  {r.points.map((pt) => <li set:html={pt} />)}
                </ul>
              )}
            </div>
            <p class="note">{r.when}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="section wide" aria-labelledby="talks">
    <h2 class="h2" id="talks" data-denoise="scroll" data-denoise-hover>Talks</h2>
    <ul class="work cv">
      {talks.map((t) => (
        <li class="work__item with-note">
          <div>
            <p class="cv__role"><b>{t.url ? <a href={t.url}>{t.title}</a> : t.title}</b></p>
            <p class="work__meta small">{t.event}{t.place && <>, {t.place}</>}, <i>{talkKind[t.kind]}</i>.</p>
          </div>
          <p class="note">{month(t.date)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wide" aria-labelledby="publications">
    <h2 class="h2" id="publications" data-denoise="scroll" data-denoise-hover>Publications</h2>
    <ul class="work cv cv--compact">
      {pubs.map((p) => (
        <li class="work__item with-note">
          <p><a href={`/publication/${p.id}/`}>{p.data.title}</a>. <cite>{p.data.venueShort}</cite>.</p>
          <p class="note">{year(p.data.date)}</p>
        </li>
      ))}
    </ul>
    <p class="more no-print"><a href="/publications/">The full list, with abstracts and BibTeX</a></p>
  </section>

  <section class="section wide" aria-labelledby="skills">
    <h2 class="h2" id="skills" data-denoise="scroll" data-denoise-hover>Skills</h2>
    <ul class="work cv cv--compact">
      {Object.entries(skills).map(([group, items]) => (
        <li class="work__item with-note">
          <p>{items.join(', ')}.</p>
          <p class="note">{group.toLowerCase()}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
  .intro { padding-top: clamp(2.5rem, 8vh, 6rem); align-items: end; }
  .intro__text { margin-top: clamp(1.2rem, 2.5vw, 2rem); max-width: 30em; }
  .intro__print { margin-top: 1.2rem; }
  .intro__note { padding-bottom: 0.4rem; }
  .more { margin-top: 2rem; font-style: italic; }

  .cv { gap: clamp(1.5rem, 2.6vw, 2.1rem); }
  .cv--compact { gap: 0.9rem; }
  .cv__role { line-height: 1.3; text-wrap: balance; }
  .cv__points { margin-top: 0.55rem; display: grid; gap: 0.3rem; max-width: 34rem; color: var(--toner-2); }
  .cv__points li { position: relative; padding-left: 1.1rem; }
  .cv__points li::before { content: '–'; position: absolute; left: 0; color: var(--toner-3); }
  .cv__points :global(em) { color: var(--toner); }

  @page { margin: 16mm 15mm; }
  @media print {
    /* The print grid in global.css has no named lines and the narrow-screen rule stacks notes;
       restore a reading column with the dates in a narrow margin column. */
    :global(.page) { grid-template-columns: [full-start] 0 [main-start] minmax(0, 1fr) [main-end note-start] 0 [note-end] 0 [full-end]; }
    .with-note { grid-template-columns: minmax(0, 1fr) 7.5rem; column-gap: 1rem; }
    .with-note > :global(.note) { grid-column: 2; margin-top: 0; }
    .intro__note { display: none; }
    /* Print at rest: no half-denoised headings, whatever the scroll position was. */
    :global(.dn__g[data-l]) { color: inherit; }
    :global(.dn__g[data-l]::after) { display: none; }
    .intro { padding-top: 0; }
    .work__item { break-inside: avoid; }
    h2 { break-after: avoid; }
    .cv { gap: 0.8rem; }
    .cv--compact { gap: 0.35rem; }
  }
</style>
