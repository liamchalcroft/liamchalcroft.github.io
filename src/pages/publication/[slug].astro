---
import { getCollection, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import ScanTile from '../../components/ScanTile.astro';
import { authorsHtml, SELF, site, year } from '../../lib/site';
import { toBibtex } from '../../lib/bibtex';
import { tileParams } from '../../lib/paperTile';

export async function getStaticPaths() {
  const pubs = (await getCollection('publications')).sort((a, b) => +b.data.date - +a.data.date);
  return pubs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: pubs[i - 1], older: pubs[i + 1], index: i + 1, total: pubs.length },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, newer, older, index, total } = Astro.props as Props;
const d = entry.data;
const b = d.bib;
const { Content } = await render(entry);
const hasAbstract = Boolean(entry.body?.trim());
const bibtex = toBibtex(entry);
const t = tileParams(entry);
const pad = (n: number) => String(n).padStart(2, '0');
const kindLabel = { journal: 'Journal paper', conference: 'Conference paper', workshop: 'Workshop paper', thesis: 'Thesis' }[d.kind];
const url = new URL(`/publication/${entry.id}/`, site.url).href;

// Google Scholar (Highwire) metadata.
const scholarAuthor = (a: string) => (a === SELF ? 'Chalcroft, Liam' : a);
const iso = d.date.toISOString().slice(0, 10).replace(/-/g, '/');
const [firstPage, lastPage] = (b.pages ?? '').split(/\s*[-–—]+\s*/).filter(Boolean);
const paperLink = d.links.paper ?? d.links.arxiv ?? d.links.pdf;
const description = hasAbstract
  ? entry.body!.replace(/\s+/g, ' ').trim().slice(0, 240).replace(/\s\S*$/, '') + '…'
  : `${d.title}. ${d.venue}.`;

const links = [
  d.links.paper && { label: 'Paper', url: d.links.paper },
  d.links.arxiv && { label: 'arXiv', url: d.links.arxiv },
  d.links.code && { label: 'Code', url: d.links.code },
  ...d.links.extra,
].filter(Boolean) as { label: string; url: string }[];
---

<Base title={d.title} description={description} series="01" ogType="article">
  <Fragment slot="head">
    <meta name="citation_title" content={d.title} />
    {d.authors.map((a) => <meta name="citation_author" content={scholarAuthor(a)} />)}
    <meta name="citation_publication_date" content={iso} />
    {b.type === 'article' && <meta name="citation_journal_title" content={b.container} />}
    {b.type === 'inproceedings' && <meta name="citation_conference_title" content={b.container} />}
    {b.type === 'phdthesis' && <meta name="citation_dissertation_institution" content={b.school ?? b.container} />}
    {b.volume && <meta name="citation_volume" content={b.volume} />}
    {b.number && <meta name="citation_issue" content={b.number} />}
    {firstPage && <meta name="citation_firstpage" content={firstPage} />}
    {lastPage && <meta name="citation_lastpage" content={lastPage} />}
    {b.publisher && <meta name="citation_publisher" content={b.publisher} />}
    {d.doi && <meta name="citation_doi" content={d.doi} />}
    {d.links.pdf && <meta name="citation_pdf_url" content={d.links.pdf} />}
    <meta name="citation_abstract_html_url" content={url} />
  </Fragment>

  <section class="head sheet" aria-labelledby="paper-title">
    <div class="head__scan span-5 md-12">
      <ScanTile
        kind={t.kind}
        n={512}
        z={t.z}
        seed={t.seed}
        protocol={t.protocol}
        order="linear"
        duration={2200}
        label={`A procedurally synthesised ${d.modality === 'mri' ? 'MRI slice' : d.modality === 'ultrasound' ? 'ultrasound frame' : 'photonics field simulation'}, seeded by this paper's slug`}
        tl={[d.venueShort, String(year(d.date))]}
        tr={[t.modalityLabel, `IM ${pad(index)}/${pad(total)}`]}
        bl={[d.title]}
      />
      <p class="head__note label">Procedural illustration synthesised from this paper's seed. Not data from the paper.</p>
    </div>

    <div class="head__info cell span-7 md-12">
      <p class="label raster">Se 01 · {kindLabel} · {year(d.date)}</p>
      <h1 class="head__title raster" id="paper-title">{d.title}</h1>
      <p class="head__authors raster" set:html={authorsHtml(d.authors, d.etAl)} />
      <p class="head__venue muted raster">{d.venue}</p>
      {(d.badge || d.note) && (
        <p class="head__badge raster">
          {d.badge && <span class="badge">{d.badge}</span>}
          {d.note && <span class="faint">{d.note}</span>}
        </p>
      )}
      <ul class="entry__links head__links raster">
        {links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
        {d.doi && <li><a href={`https://doi.org/${d.doi}`}>DOI</a></li>}
      </ul>
    </div>
  </section>

  <section class="sheet" aria-label="Abstract and details">
    <div class="cell span-8 md-12">
      <p class="label">Abstract</p>
      <div class="prose abstract raster">
        {hasAbstract
          ? <Content />
          : <p class="muted">The thesis is not summarised here. Read it at the <a href={paperLink ?? '/publications/'}>paper link</a>.</p>}
      </div>
    </div>
    <div class="cell span-4 md-12">
      <p class="label">Record</p>
      <dl class="readout record">
        <dt>Year</dt><dd>{year(d.date)}</dd>
        <dt>Type</dt><dd>{kindLabel}</dd>
        <dt>Venue</dt><dd>{b.container}</dd>
        {b.volume && <><dt>Volume</dt><dd>{b.volume}</dd></>}
        {b.number && <><dt>Issue</dt><dd>{b.number}</dd></>}
        {b.pages && <><dt>Pages</dt><dd>{b.pages}</dd></>}
        {d.doi && <><dt>DOI</dt><dd><a href={`https://doi.org/${d.doi}`}>{d.doi}</a></dd></>}
      </dl>
    </div>
  </section>

  {d.figure && (
    <section class="sheet" aria-label="Figure">
      <figure class="cell span-12 fig">
        <img src={d.figure.src} width={d.figure.width} height={d.figure.height} alt={d.figure.alt} loading="lazy" decoding="async" />
        <figcaption class="label">Figure from the paper.{d.figure.caption ? ` ${d.figure.caption}` : ''}</figcaption>
      </figure>
    </section>
  )}

  <section class="sheet" aria-labelledby="cite">
    <div class="cell span-12 cite">
      <div class="cite__bar">
        <h2 class="label" id="cite">Cite</h2>
        <button class="btn no-print" type="button" id="copy-bib" data-label="Copy BibTeX">Copy BibTeX</button>
      </div>
      <pre class="cite__pre" id="bibtex"><code>{bibtex}</code></pre>
    </div>
  </section>

  <nav class="sheet pager" aria-label="Other papers">
    {newer
      ? <a class="cell span-6 md-12 pager__link" href={`/publication/${newer.id}/`} rel="prev">
          <span class="label">← Previous · {year(newer.data.date)}</span>
          <span class="pager__title">{newer.data.shortTitle}</span>
        </a>
      : <div class="cell span-6 md-12 pager__empty" aria-hidden="true"></div>}
    {older
      ? <a class="cell span-6 md-12 pager__link pager__link--next" href={`/publication/${older.id}/`} rel="next">
          <span class="label">Next · {year(older.data.date)} →</span>
          <span class="pager__title">{older.data.shortTitle}</span>
        </a>
      : <div class="cell span-6 md-12 pager__empty" aria-hidden="true"></div>}
  </nav>
</Base>

<script>
  import { initScans } from '../../scripts/scan-client';
  initScans();

  const btn = document.getElementById('copy-bib') as HTMLButtonElement | null;
  const pre = document.getElementById('bibtex');
  if (btn && pre) {
    const text = () => pre.textContent ?? '';
    const flash = (msg: string) => {
      btn.textContent = msg;
      setTimeout(() => (btn.textContent = btn.dataset['label'] ?? 'Copy BibTeX'), 1800);
    };
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text());
        flash('Copied');
      } catch {
        // Clipboard blocked (insecure context, permissions): select the text so Ctrl+C works.
        const sel = getSelection();
        const range = document.createRange();
        range.selectNodeContents(pre);
        sel?.removeAllRanges();
        sel?.addRange(range);
        flash('Press Ctrl+C');
      }
    });
  }
</script>

<style>
  .head { border-top: 0; }
  .head__scan { background: var(--cell); display: flex; flex-direction: column; }
  .head__scan :global(.tile) { width: 100%; }
  .head__scan :global(.ann--bl) { max-width: 82%; }
  .head__note { padding: 12px var(--pad) 14px; border-top: 1px solid var(--rule); }
  .head__info { display: flex; flex-direction: column; gap: 0; padding-top: clamp(24px, 3vw, 44px); padding-bottom: clamp(24px, 3vw, 44px); }
  .head__title {
    margin: 16px 0 22px -0.03em;
    font-size: clamp(2rem, 3.7vw, 3.5rem);
    font-weight: 560;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .head__authors { font-size: 1.05rem; color: var(--ink-2); max-width: 56ch; }
  .head__venue { margin-top: 10px; font-size: 1rem; }
  .head__badge { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: baseline; font-size: 0.92rem; }
  .head__links { margin-top: auto; padding-top: 28px; font-size: 0.78rem; gap: 6px 22px; }

  .abstract { margin-top: 14px; font-size: 1.04rem; }
  .record { margin-top: 12px; }
  .record dd { overflow-wrap: anywhere; }

  .fig img { width: 100%; height: auto; max-width: 1116px; margin: 0 auto; background: #fff; border: 1px solid var(--rule); }
  .fig figcaption { margin-top: 12px; max-width: 1116px; margin-inline: auto; }

  .cite__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 14px; }
  .cite__pre {
    margin: 0; padding: 16px; overflow-x: auto;
    background: var(--film); color: var(--film-ink);
    font: 400 0.8rem/1.6 var(--mono); letter-spacing: 0.02em; tab-size: 2;
  }
  .cite__pre code { font: inherit; letter-spacing: inherit; white-space: pre; }

  .pager { margin-top: clamp(40px, 5vw, 72px); }
  .pager__link { display: flex; flex-direction: column; gap: 10px; text-decoration: none; min-height: 132px; justify-content: space-between; }
  .pager__link--next { text-align: right; align-items: flex-end; }
  .pager__link:hover { background: var(--ink) !important; color: var(--bg); }
  .pager__link:hover .label { color: inherit; }
  .pager__title { font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -0.03em; font-weight: 520; line-height: 1.1; max-width: 26ch; }
  @media (max-width: 1080px) { .pager__empty { display: none; } }
  @media (max-width: 640px) { .pager__link--next { text-align: left; align-items: flex-start; } }

  @media print {
    .head__note { display: none; }
    .pager { display: none; }
    .cite__pre { background: none; color: #000; border: 1px solid #bbb; white-space: pre-wrap; }
  }
</style>
