---
/**
 * A film tile holding nothing but Rician noise: the magnitude of complex
 * Gaussian noise, which is what an MR scanner records when there is no signal.
 * No anatomy, only a floor. Animated with requestAnimationFrame; a single
 * still frame under prefers-reduced-motion.
 */
interface Props {
  label: string;
  tl?: string[];
  tr?: string[];
  bl?: string[];
  br?: string[];
  class?: string;
}
const { label, tl = [], tr = [], bl = [], br = [], class: cls } = Astro.props;
---

<figure class:list={['tile', 'noise', cls]}>
  <canvas width="320" height="140" role="img" aria-label={label} data-noise></canvas>
  <div class="ann ann--tl" aria-hidden="true">{tl.map((l) => <span>{l}</span>)}</div>
  <div class="ann ann--tr" aria-hidden="true">{tr.map((l) => <span>{l}</span>)}</div>
  <div class="ann ann--bl" aria-hidden="true">{bl.map((l) => <span>{l}</span>)}</div>
  <div class="ann ann--br" aria-hidden="true">{br.map((l) => <span>{l}</span>)}</div>
</figure>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-noise]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Rayleigh table: |N(0,1) + i N(0,1)| is the Rician distribution at zero signal.
    const TABLE = 1 << 16;
    const rayleigh = new Uint8Array(TABLE);
    for (let i = 0; i < TABLE; i++) {
      // Magnitude of two independent Gaussians is Rayleigh: sqrt(-2 ln U).
      const r = Math.sqrt(-2 * Math.log(Math.random() || 1e-9));
      rayleigh[i] = Math.min(255, Math.round(r * 30));
    }

    let image: ImageData | null = null;
    let words: Uint32Array | null = null;

    const size = () => {
      const r = canvas.getBoundingClientRect();
      canvas.width = Math.max(64, Math.ceil(r.width / 3.5));
      canvas.height = Math.max(48, Math.ceil(r.height / 3.5));
      image = ctx.createImageData(canvas.width, canvas.height);
      words = new Uint32Array(image.data.buffer);
    };

    const frame = () => {
      if (!image || !words) return;
      let s = (Math.random() * 0xffffffff) >>> 0 || 1;
      const n = words.length;
      for (let i = 0; i < n; i++) {
        // xorshift32 picks a table entry: cheap, and independent enough for grain.
        s ^= s << 13; s >>>= 0; s ^= s >>> 17; s ^= s << 5; s >>>= 0;
        const v = rayleigh[s & (TABLE - 1)]!;
        words[i] = 0xff000000 | (v << 16) | (v << 8) | v;
      }
      ctx.putImageData(image, 0, 0);
    };

    size();
    frame();

    if (!reduced) {
      let last = 0;
      const tick = (now: number) => {
        if (now - last > 66) { last = now; frame(); }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    let timer = 0;
    addEventListener('resize', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => { size(); frame(); }, 150);
    });
  }
</script>

<style>
  .noise { aspect-ratio: 21 / 8; }
  .noise canvas { width: 100%; height: 100%; }
  @media (max-width: 640px) { .noise { aspect-ratio: 4 / 3; } }
</style>
