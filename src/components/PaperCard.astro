---
import type { CollectionEntry } from 'astro:content';
import ScanTile from './ScanTile.astro';
import { authorsHtml, year } from '../lib/site';

interface Props { entry: CollectionEntry<'publications'>; index: number; class?: string }
const { entry, index, class: cls } = Astro.props;
const d = entry.data;
const href = `/publication/${entry.id}/`;
const protocols = ['T1w', 'T2w', 'FLAIR', 'PDw', 'T2*w'];
// A fixed protocol per paper, so each thumbnail is stable across visits.
const protocol = protocols[entry.id.length % protocols.length];
const modalityLabel = { mri: 'MR', ultrasound: 'US', photonics: 'FDTD' }[d.modality];
---

<article class:list={['paper', cls]} data-replay-host>
  <a href={href} class="paper__thumb" tabindex="-1" aria-hidden="true">
    <ScanTile
      kind={d.modality}
      n={256}
      z={0.02 + (entry.id.length % 5) * 0.06}
      seed={entry.id}
      protocol={protocol}
      duration={1100}
      hover="replay"
      label=""
      tl={[`IM ${String(index).padStart(2, '0')}`, modalityLabel]}
      tr={[d.venueShort]}
      bl={[d.shortTitle]}
    />
  </a>
  <div class="paper__body cell">
    <div class="entry__meta">
      <span class="label">{year(d.date)} · {d.kind}</span>
      {d.badge && <span class="badge">{d.badge}</span>}
    </div>
    <h3 class="entry__title"><a href={href}>{d.title}</a></h3>
    <p class="entry__authors" set:html={authorsHtml(d.authors, d.etAl)} />
    <p class="entry__venue">{d.venue}</p>
    <ul class="entry__links">
      {d.links.paper && <li><a href={d.links.paper}>Paper</a></li>}
      {d.links.arxiv && <li><a href={d.links.arxiv}>arXiv</a></li>}
      {d.links.code && <li><a href={d.links.code}>Code</a></li>}
    </ul>
  </div>
</article>

<style>
  .paper { display: flex; flex-direction: column; background: var(--cell); }
  .paper__thumb { display: block; }
  .paper__body { flex: 1; }
  .paper :global(.tile) { aspect-ratio: 16 / 10; }
  .paper :global(.tile canvas) { object-fit: cover; }
</style>
