---
/**
 * Title block for the secondary pages: series label, the page's h1, a short
 * intro and, optionally, a right-hand cell (`aside` slot) for counts or actions.
 */
interface Props { code: string; label: string; title: string }
const { code, label, title } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="pagehead sheet" aria-labelledby="page-title">
  <div class:list={['cell', 'pagehead__main', hasAside ? 'span-8 md-12' : 'span-12']}>
    <p class="label raster">Se {code} · {label}</p>
    <h1 class="pagehead__title" id="page-title">{title}</h1>
    <div class="pagehead__intro prose raster"><slot /></div>
  </div>
  {hasAside && <div class="cell span-4 md-12 pagehead__aside"><slot name="aside" /></div>}
</section>

<style>
  .pagehead { border-top: 0; }
  .pagehead__main { padding-top: clamp(28px, 4vw, 56px); padding-bottom: clamp(24px, 3vw, 44px); }
  .pagehead__title {
    margin: 14px 0 22px -0.04em;
    font-size: clamp(2.8rem, 7.4vw, 6.6rem);
    font-weight: 560;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .pagehead__intro { font-size: 1.05rem; color: var(--ink-2); }
  .pagehead__aside { display: flex; flex-direction: column; justify-content: flex-end; gap: 14px; }
</style>
