---
interface Props { code: string; title: string; id?: string; aside?: string }
const { code, title, id, aside } = Astro.props;
---

<header class="sechead raster">
  <p class="sechead__code mono">Se {code}</p>
  <h2 class="sechead__title" id={id}>{title}</h2>
  {aside && <p class="sechead__aside mono">{aside}</p>}
  <slot />
</header>
