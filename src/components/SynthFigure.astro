---
/**
 * The one figure on the home page: a brain that doesn't exist, from tissue
 * labels to an MR image, re-drawable under any sequence.
 */
const protocols = ['T1w', 'PDw', 'T2*w', 'T2w', 'FLAIR', 'Synthetic'];
---

<figure class="synth wide" data-synth>
  <div class="synth__panels">
    <div class="synth__panel">
      <canvas width="256" height="256" data-panel="labels" role="img" aria-label="Tissue label map of a synthetic brain slice"></canvas>
      <p class="small"><i>a</i>&ensp;Labels</p>
    </div>
    <div class="synth__panel">
      <canvas width="256" height="256" data-panel="image" role="img" aria-label="MR image synthesised from the label map"></canvas>
      <p class="small"><i>b</i>&ensp;<span data-synth-protocol>Image</span></p>
    </div>
  </div>
  <figcaption class="synth__cap small">
    <p>
      <b>Figure 1.</b> A synthetic brain MRI slice, generated in your browser. <i>(a)</i> A tissue label map sampled from a random
      seed, with a lesion (<span class="synth__key">highlighted</span>). <i>(b)</i> An image simulated from the labels: each tissue is
      given a proton density and T1, T2 and T2* values, and the signal is computed for the selected sequence. Training on many
      such images, across sequences and with random intensities, is the approach used in SynthStroke and qSynth.
    </p>
    <p class="synth__controls no-print">
      <button class="button" type="button" data-synth-resample>New seed</button>
      <span class="faint">Sequence:</span>
      {protocols.map((p) => <button class="button" type="button" data-synth-proto={p} aria-pressed="false">{p}</button>)}
    </p>
  </figcaption>
</figure>

<style>
  .synth { margin-block: clamp(2.5rem, 6vw, 4.5rem); display: grid; grid-template-columns: minmax(0, var(--measure)) var(--gap) minmax(0, var(--note)); align-items: end; }
  .synth__panels { grid-column: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .synth__panel canvas { width: 100%; aspect-ratio: 1; background: #000; }
  .synth__panel p { margin-top: 0.4rem; color: var(--toner-2); }
  .synth__cap { grid-column: 3; color: var(--toner-2); }
  .synth__cap p + p { margin-top: 0.7rem; }
  .synth__cap b { color: var(--toner); font-weight: 700; }
  .synth__key { background: #ffe94a; color: #141312; padding: 0 0.15em; }
  .synth__controls { display: flex; flex-wrap: wrap; gap: 0.15rem 0.6rem; }
  .synth__controls [aria-pressed='true'] { background: var(--mark); color: var(--mark-ink); text-decoration: none; }
  @media (max-width: 1000px) {
    .synth { grid-template-columns: minmax(0, 1fr); }
    .synth__cap { grid-column: 1; margin-top: 1rem; }
  }
</style>

<script>
  import { makeAnatomy } from '../lib/scan/phantom';
  import { makeProtocol, PROTOCOL_NAMES, type ProtocolName } from '../lib/scan/physics';
  import { mulberry32, pick } from '../lib/scan/prng';
  import { getSeed } from '../scripts/denoise';
  import type { Result } from '../lib/scan/worker';

  const fig = document.querySelector<HTMLElement>('[data-synth]');
  if (fig) {
    const worker = new Worker(new URL('../lib/scan/worker.ts', import.meta.url), { type: 'module' });
    const labelsCv = fig.querySelector<HTMLCanvasElement>('[data-panel="labels"]')!;
    const imageCv = fig.querySelector<HTMLCanvasElement>('[data-panel="image"]')!;
    const protoText = fig.querySelector<HTMLElement>('[data-synth-protocol]')!;
    const N = 256;

    let seed = getSeed();
    let protocol: ProtocolName = pick(mulberry32(seed ^ 0x9e37), PROTOCOL_NAMES);
    let id = 0;

    // Greys for air, scalp, skull, CSF, GM, WM, deep GM; the lesion is highlighter yellow.
    const GREY = [0, 150, 55, 35, 120, 200, 95];

    worker.onmessage = (e: MessageEvent<Result>) => {
      const r = e.data;
      if (r.id !== id) return;
      const li = new ImageData(N, N), ii = new ImageData(N, N);
      for (let p = 0; p < N * N; p++) {
        const l = r.labels[p]!;
        if (l === 7) { li.data[p * 4] = 255; li.data[p * 4 + 1] = 233; li.data[p * 4 + 2] = 74; }
        else li.data[p * 4] = li.data[p * 4 + 1] = li.data[p * 4 + 2] = GREY[l]!;
        li.data[p * 4 + 3] = 255;
        const v = Math.min(255, (255 * r.img[p]!) / r.white);
        ii.data[p * 4] = ii.data[p * 4 + 1] = ii.data[p * 4 + 2] = v;
        ii.data[p * 4 + 3] = 255;
      }
      labelsCv.getContext('2d')!.putImageData(li, 0, 0);
      imageCv.getContext('2d')!.putImageData(ii, 0, 0);
    };

    function describe(p: ReturnType<typeof makeProtocol>): string {
      switch (p.kind) {
        case 'spgr': return `${p.name}, spoiled gradient echo: TR ${p.tr} ms, TE ${p.te} ms, flip ${p.fa}°`;
        case 'fse': return `${p.name}, fast spin echo: TR ${p.tr} ms, TE ${p.te} ms`;
        case 'flair': return `FLAIR: TR ${p.tr} ms, TI ${p.ti} ms, TE ${p.te} ms`;
        case 'gmm': return 'Random intensity per tissue (no signal model)';
      }
    }

    function render() {
      const z = Math.min(0.4, Math.max(-0.05, makeAnatomy(seed).lesion?.c[2] ?? 0.12));
      worker.postMessage({ id: ++id, seed, z, n: N, protocol, noise: 0.015 });
      const p = makeProtocol(mulberry32(seed ^ 0x51), protocol);
      protoText.textContent = describe(p);
      fig!.querySelectorAll<HTMLButtonElement>('[data-synth-proto]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset['synthProto'] === protocol)));
    }

    fig.querySelector('[data-synth-resample]')!.addEventListener('click', () => {
      seed = crypto.getRandomValues(new Uint32Array(1))[0]!;
      render();
    });
    fig.querySelectorAll<HTMLButtonElement>('[data-synth-proto]').forEach((b) =>
      b.addEventListener('click', () => { protocol = b.dataset['synthProto'] as ProtocolName; render(); }));

    new IntersectionObserver((entries, io) => {
      if (entries[0]!.isIntersecting) { io.disconnect(); render(); }
    }, { rootMargin: '30% 0px' }).observe(fig);
  }
</script>
