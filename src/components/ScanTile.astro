---
/**
 * A black film tile holding one synthesised image, with scanner-style corner
 * annotations. `seed` fixes the image (papers pass their slug); without it the
 * tile follows the visitor's subject.
 */
interface Props {
  kind?: 'mri' | 'ultrasound' | 'photonics' | undefined;
  n?: number | undefined;
  z?: number | undefined;
  seed?: string | undefined;
  protocol?: string | undefined;
  order?: 'linear' | 'centric' | undefined;
  duration?: number | undefined;
  hover?: 'replay' | undefined;
  kspace?: string | undefined;
  id?: string | undefined;
  manual?: boolean | undefined;
  label: string;
  tl?: string[] | undefined;
  tr?: string[] | undefined;
  bl?: string[] | undefined;
  br?: string[] | undefined;
  class?: string | undefined;
}
const { kind = 'mri', n = 128, z, seed, protocol, order = 'centric', duration, hover, kspace, id, manual, label, tl = [], tr = [], bl = [], br = [], class: cls } = Astro.props;
---

<figure class:list={['tile', cls]} data-replay-host={hover ? '' : undefined}>
  <canvas
    id={id}
    width={n}
    height={n}
    role="img"
    aria-label={label}
    data-scan={kind}
    data-n={n}
    data-z={z}
    data-seed={seed}
    data-protocol={protocol}
    data-order={order}
    data-duration={duration}
    data-hover={hover}
    data-kspace={kspace}
    data-manual={manual ? '' : undefined}
  ></canvas>
  <div class="ann ann--tl" aria-hidden="true">{tl.map((l) => <span>{l}</span>)}<slot name="tl" /></div>
  <div class="ann ann--tr" aria-hidden="true">{tr.map((l) => <span>{l}</span>)}<slot name="tr" /></div>
  <div class="ann ann--bl" aria-hidden="true">{bl.map((l) => <span>{l}</span>)}<slot name="bl" /></div>
  <div class="ann ann--br" aria-hidden="true">{br.map((l) => <span>{l}</span>)}<slot name="br" /></div>
  <slot />
</figure>
